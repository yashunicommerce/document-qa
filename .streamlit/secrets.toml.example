# Copy to .streamlit/secrets.toml (local) or configure in Streamlit Cloud secrets.

# Optional — app works offline with bundled data/channels_index.json.
# For Shopify channels use the `shopify` database and `channel` collection.
SHOPIFY_MONGO_URI = ""
SHOPIFY_MONGO_DB = "shopify"
ORDER_JSON_TEST_URL = "https://shopifyproxy.unicommerce.com/shopify/orders/order-json-test"
# The server-side validation context is fixed by the app; no UI selection is required.
USE_LOCAL_INDEX = "true"
